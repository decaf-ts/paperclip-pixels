{
  "name": "@decaf-ts/paperclip-pixels-plugin",
  "version": "0.6.0",
  "description": "Independent Paperclip plugin for the Paperclip <-> Pixel Agents bridge: Paperclip SDK worker, Pixel Office UI (page + sidebar), persistence, metrics, policy, snapshot/event normalization, reconciliation, and the outbound feed mapper + retry/observability client. Depends only on `@decaf-ts/paperclip-pixels-common`.",
  "type": "module",
  "main": "dist/worker.js",
  "types": "dist/worker.d.ts",
  "exports": {
    ".": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    },
    "./manifest": {
      "import": "./dist/manifest.js",
      "types": "./dist/manifest.d.ts"
    },
    "./ui": {
      "import": "./dist/ui/index.js",
      "types": "./dist/ui/index.d.ts"
    }
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "assets/characters",
    "assets/composition",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "node scripts/build.mjs && node scripts/build-ui.mjs && npm run build:types",
    "build:worker": "node scripts/build.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "jest --config jest.config.ts",
    "test:domain": "jest --config jest.config.domain.ts",
    "test:worker": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:all": "npm run test:domain && npm run test:worker && npm run test",
    "prepare-release": "npm run lint && npm run typecheck && npm run typecheck:ui && npm run build && npm run test:all && npm run test:perf && npm pack --dry-run",
    "release": "bash bin/tag-release.sh"
  },
  "keywords": [
    "paperclip",
    "pixel-agents",
    "bridge",
    "plugin",
    "worker",
    "relay"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@decaf-ts/paperclip-pixels-common": "0.1.0",
    "ws": "^8.10.5",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@decaf-ts/utils": "^1.11.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}

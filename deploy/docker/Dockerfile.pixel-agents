# syntax=docker/dockerfile:1
#
# Pixel Agents standalone server (SPA + WebSocket + hook ingest endpoint)
# with the Paperclip bridge embedding surface loaded at startup.
#
# The upstream submodule ships no Dockerfile, so this builds the standalone
# CLI from source (see deploy/README.md — this is a build artifact, not a
# source patch). Runtime serves the React webview + /ws + /api/hooks/:id +
# /api/health.
#
# The fork's generic `--plugin <module>` startup loader (server/src/plugins/
# moduleLoader.ts) is pointed at the Paperclip bridge embedding module
# (dist/pixel-agents-embedding.cjs — built from this repo's
# src/pixel-agents-plugin/embedding.ts by `npm run build` at the repo root,
# BEFORE this image is built; the runbook's step 1). The module registers the
# Paperclip plugin through the in-process plugin host and serves the relay's
# POST /api/plugin-feed endpoint on its own sidecar listener (default
# 127.0.0.1:8081; bind/port/token via PAPERCLIP_PIXEL_FEED_* env — see the
# module's doc comment). All Paperclip-specific glue lives in that module;
# the fork itself stays provider-agnostic.
#
# Build (from the repo root, submodules initialized, plugin repo built):
#   npm install && npm run build        # produces dist/pixel-agents-embedding.cjs
#   docker build -t pixel-agents:local -f deploy/docker/Dockerfile.pixel-agents .
#
# Run:  docker run --rm -p 8080:8080 \
#         -e PAPERCLIP_PIXEL_FEED_HOST=0.0.0.0 -e PAPERCLIP_PIXEL_FEED_PORT=8081 \
#         -e PAPERCLIP_PIXEL_FEED_TOKEN=<shared-secret> \
#         -e PAPERCLIP_PIXEL_API_BASE_URL=http://paperclip:3100 \
#         -e PAPERCLIP_PIXEL_API_TOKEN=<board-api-key> \
#         pixel-agents:local

FROM node:22-bookworm-slim AS builder
WORKDIR /build

# Copy the submodule (with its lockfile) and install all workspace deps.
COPY pixel-agents/package.json pixel-agents/package-lock.json ./
COPY pixel-agents/server ./server
COPY pixel-agents/webview-ui ./webview-ui
COPY pixel-agents/core ./core
COPY pixel-agents/adapters ./adapters
COPY pixel-agents/scripts ./scripts
COPY pixel-agents/esbuild.js pixel-agents/tsconfig.json pixel-agents/eslint.config.mjs ./

RUN npm ci --ignore-scripts

# Produce runtime artifacts only (skip dev gates: check-types / lint).
RUN npm run asyncapi:generate || true
RUN node esbuild.js
RUN cd webview-ui && npm run build

# --- runtime stage ---
FROM node:22-bookworm-slim AS runtime
WORKDIR /app

# The server reads its dist from the cwd's dist/ and serves dist/webview/.
# esbuild externalizes node_modules, so the runtime stage needs the server's
# runtime deps (fastify + plugins) alongside the bundle.
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/node_modules ./node_modules

# Paperclip bridge embedding module (this repo's own code, self-contained
# bundle: node built-ins external, zero runtime deps). The retired
# bin/paperclip-pixel-relay.js sidecar (impersonation path, WS2-C) is gone —
# the bridge now runs in-process behind the CLI's generic --plugin loader.
COPY dist/pixel-agents-embedding.cjs /opt/paperclip-pixel-embedding/pixel-agents-embedding.cjs

# Pixel Agents persists server registry + layout under ~/.pixel-agents/.
RUN mkdir -p /home/node/.pixel-agents && chown -R node:node /home/node /app

USER node
ENV HOME=/home/node

EXPOSE 8080 8081
ENTRYPOINT ["node", "dist/cli.js"]
CMD ["--host", "0.0.0.0", "--port", "8080", "--plugin", "/opt/paperclip-pixel-embedding/pixel-agents-embedding.cjs"]

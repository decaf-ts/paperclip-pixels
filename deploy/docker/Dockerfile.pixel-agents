# syntax=docker/dockerfile:1
#
# Pixel Agents standalone server (SPA + WebSocket + hook ingest endpoint)
# with the Paperclip bridge embedding surface loaded at startup.
#
# The upstream submodule ships no Dockerfile, so this builds the standalone
# CLI from source (see deploy/README.md — this is a build artifact, not a
# source patch). Runtime serves the React webview + /ws + /api/hooks/:id +
# /api/health.
#
# The fork's generic `--plugin <module>` startup loader (server/src/plugins/
# moduleLoader.ts) is pointed at the Paperclip bridge embedding module
# (plugins/pixel-agents/dist/pixel-agents-embedding.cjs — built from this
# repo's independent Pixel Agents plugin package
# `plugins/pixel-agents/src/embedding.ts` by `npm --prefix plugins/pixel-agents
# run build` BEFORE this image is built; the runbook's step 1). The module
# registers the
# Paperclip plugin through the in-process plugin host and serves the relay's
# POST /api/plugin-feed endpoint on its own sidecar listener (default
# 127.0.0.1:8081; bind/port/token via PAPERCLIP_PIXEL_FEED_* env — see the
# module's doc comment). All Paperclip-specific glue lives in that module;
# the fork itself stays provider-agnostic.
#
# Build (from the repo root, submodules initialized, plugin packages built):
#   npm --prefix plugins/pixel-agents run build   # produces plugins/pixel-agents/dist/pixel-agents-embedding.cjs
#   docker build -t pixel-agents:local -f deploy/docker/Dockerfile.pixel-agents .
#
# Run:  docker run --rm -p 8080:8080 \
#         -e PAPERCLIP_PIXEL_FEED_HOST=0.0.0.0 -e PAPERCLIP_PIXEL_FEED_PORT=8081 \
#         -e PAPERCLIP_PIXEL_FEED_TOKEN=<shared-secret> \
#         -e PAPERCLIP_PIXEL_API_BASE_URL=http://paperclip:3100 \
#         -e PAPERCLIP_PIXEL_API_TOKEN=<board-api-key> \
#         pixel-agents:local

FROM node:22-bookworm-slim AS builder
WORKDIR /build

# Copy the submodule (with its lockfile) and install all workspace deps.
COPY pixel-agents/package.json pixel-agents/package-lock.json ./
COPY pixel-agents/server ./server
COPY pixel-agents/webview-ui ./webview-ui
COPY pixel-agents/core ./core
COPY pixel-agents/adapters ./adapters
COPY pixel-agents/scripts ./scripts
COPY pixel-agents/esbuild.js pixel-agents/tsconfig.json pixel-agents/eslint.config.mjs ./

RUN npm ci --ignore-scripts

# Produce runtime artifacts only (skip dev gates: check-types / lint).
RUN npm run asyncapi:generate || true
RUN node esbuild.js
RUN cd webview-ui && npm run build

# --- runtime stage ---
FROM node:22-bookworm-slim AS runtime
WORKDIR /app

# The server reads its dist from the cwd's dist/ and serves dist/webview/.
# esbuild externalizes node_modules, so the runtime stage needs the server's
# runtime deps (fastify + plugins) alongside the bundle.
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/node_modules ./node_modules

# Paperclip bridge embedding module (the independent Pixel Agents plugin
# package's own bundle, self-contained: node built-ins external, zero runtime
# deps). The retired bin/paperclip-pixel-relay.js sidecar (impersonation
# path, WS2-C) is gone — the bridge now runs in-process behind the CLI's
# generic --plugin loader.
COPY plugins/pixel-agents/dist/pixel-agents-embedding.cjs /opt/paperclip-pixel-embedding/pixel-agents-embedding.cjs

# ── WS3 character/appearance catalog ─────────────────────────────────────
# The embedding's `resolveCharacterCatalogDir` walks up from this module's
# own location looking for `assets/characters/catalog.json`; vendoring the
# Paperclip plugin's catalogue beside the embedding module makes the WS4-C
# `declareCharacterCatalog` (and the WS4-A appearance adoption) work in the
# two-plugin topology, matching the former combined build. The catalogue is
# the same CC0 sheet set the host image vendors at
# /opt/paperclip-pixel-plugin/assets/characters — this copy lives in the
# pixel-agents image so the embedding's ancestor walk finds it. Without it a
# fresh two-plugin deployment degrades to built-in palettes
# (paperclip_appearance_catalog_unavailable).
#
# This baked copy is the DEFAULT fallback (PAPERCLIP_PIXELS-2 condition C2):
# a deployment that delivers the shared sprites/characters assets via a
# volume (compose/k8s/helm `shared-assets`) mounts that volume at
# /opt/paperclip-pixel-shared-assets and points the catalog loader at it with
# the PIXEL_CHARACTER_CATALOG env override — see deploy/README.md "Shared
# sprites/characters assets". The baked copy is used whenever that override
# is absent, so an image without the shared volume still works.
COPY plugins/paperclip/assets /opt/paperclip-pixel-embedding/assets

# Pixel Agents persists server registry + layout under ~/.pixel-agents/.
#
# Seed the WS1 `externalAssetDirectories` grant so the plugin host's
# `PluginAppearanceAssetGate` accepts the character sheets declared through
# `declareCharacterCatalog` (the WS4-A privilege gate refuses any sheet
# outside an operator-granted directory). The grant deliberately names the
# `assets/characters` subdirectory, NOT the embedding root: the gate only
# needs the sheet paths inside the grant, while the root grant would ALSO
# make the startup `buildAssetCache` merge the catalog into the built-in
# character array (the retired WS3 merged-array path), which would duplicate
# the characters in the picker. The server re-reads config on every gate
# call / declaration; its own writes preserve `externalAssetDirectories`.
#
# The second grant (/opt/paperclip-pixel-shared-assets/characters) covers the
# shared-asset volume mount (PAPERCLIP_PIXELS-2 condition C2): when the
# shared volume overrides the catalog via PIXEL_CHARACTER_CATALOG, the sheets
# live under that granted subdirectory, so the WS4-C `declareCharacterCatalog`
# gate still accepts them. It names the characters subdir (not the mount
# root) for the same reason as the embedding copy above, and it is inert when
# the shared volume is not mounted (the dir just does not exist). The baked
# copy at /opt/paperclip-pixel-embedding/assets/characters stays granted as
# the default fallback.
RUN mkdir -p /home/node/.pixel-agents \
  && printf '%s\n' '{"externalAssetDirectories":["/opt/paperclip-pixel-embedding/assets/characters","/opt/paperclip-pixel-shared-assets/characters"]}' \
    > /home/node/.pixel-agents/config.json \
  && chown -R node:node /home/node /app

USER node
ENV HOME=/home/node

EXPOSE 8080 8081
ENTRYPOINT ["node", "dist/cli.js"]
CMD ["--host", "0.0.0.0", "--port", "8080", "--plugin", "/opt/paperclip-pixel-embedding/pixel-agents-embedding.cjs"]

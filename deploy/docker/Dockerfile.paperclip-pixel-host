# syntax=docker/dockerfile:1
#
# Paperclip Pixel Agents bridge host.
#
# Built FROM the published Paperclip image, completely unpatched — the bridge
# plugin only needs public plugin SDK surfaces (ctx.events, ctx.http.fetch,
# ctx.actions, ctx.data), never Paperclip's internal stream-bus wiring.
#
#   docker build -t paperclip-pixel-host:local -f deploy/docker/Dockerfile.paperclip-pixel-host .
#
# (An earlier revision of this Dockerfile applied two build-time patches
# — SAA-316/SAA-320 — to wire Paperclip's `createPluginStreamBus()` and seed
# proactive plugin-worker scopes, purely so the plugin's OWN embedded
# dashboard page could get live SSE push updates from its worker instead of
# polling. That machinery is unrelated to the Paperclip<->Pixel Agents bridge
# itself (which pushes over plain `ctx.http.fetch`, never touches the stream
# bus) and added a real, if disclosed, Paperclip source patch for a
# cosmetic UI feature. Removed in favor of the plugin's own polling-based
# `useBridge` refresh, which was always the fallback path anyway. If someone
# wants the live-push UX back, the right fix is a genuine small upstream PR to
# Paperclip wiring `bridgeDeps.streamBus` natively — not a build-time patch
# here.)
#
# On top of the base this image adds:
#   1. The built Paperclip-Pixel bridge plugin at /opt/paperclip-pixel-plugin
#      (installed into the running instance at first boot by the entrypoint).
#   2. A custom entrypoint (docker/bridge-stack-entrypoint.sh) that performs a
#      one-shot loopback `local_trusted` bootstrap to install the local plugin
#      with no auth, then `exec`s the real authenticated/lan server.

FROM ghcr.io/paperclipai/paperclip:latest

# The base image WORKDIR is /app (the Paperclip monorepo root: server/, ui/,
# packages/, ...).
WORKDIR /app

USER root

# ── Production runtime env ────────────────────────────────────────────────
# These mirror the upstream production stage. The deploy compose/k8s env
# overrides the deployment-mode/public-url/home values at runtime.
ENV NODE_ENV=production \
  HOME=/paperclip \
  HOST=0.0.0.0 \
  PORT=3100 \
  SERVE_UI=true \
  PAPERCLIP_HOME=/paperclip \
  PAPERCLIP_INSTANCE_ID=default \
  PAPERCLIP_CONFIG=/paperclip/instances/default/config.json \
  PAPERCLIP_DEPLOYMENT_MODE=authenticated \
  PAPERCLIP_DEPLOYMENT_EXPOSURE=private \
  OPENCODE_ALLOW_ALL_MODELS=true \
  GEMINI_SANDBOX=false

# Upstream UID/GID-remap + gosu drop entrypoint. Present in the published
# production image; copied here so a lean `--target build` base has it too.
COPY paperclip/scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# ── Bridge plugin (vendored, installed at first boot by the entrypoint) ───────
# Vendored from the independent Paperclip plugin package
# `plugins/paperclip`, never the combined root build (removed in R3-M4). The
# plugin worker + manifest are bundled by esbuild into self-contained single
# files (plugins/paperclip/scripts/build.mjs) that inline the plugin's own
# src/ source, paperclip-pixels-common, @paperclipai/plugin-sdk,
# @paperclipai/shared, and zod, externalizing only node built-ins. The
# install location needs the plugin package.json + its dist/ plus its
# assets/characters (and assets/composition) — the WS3 per-agent character
# catalog the worker reads off disk at runtime
# (plugins/paperclip/src/characters.ts resolves
# `<package root>/assets/characters`; a missing catalog fails closed and
# breaks the visual-settings/appearance flow, observed live on the 2026-09-02
# WS2-D redeploy). The plugin bundle is built in the CI/release step before
# this image is assembled (`npm --prefix plugins/paperclip run build`); here
# we only copy the already-built dist.
COPY deploy/docker/build-plugin-bundle.sh /tmp/build-plugin-bundle.sh
COPY plugins/paperclip/package.json /tmp/src/paperclip-pixels-plugin/package.json
COPY plugins/paperclip/dist /tmp/src/paperclip-pixels-plugin/dist
COPY plugins/paperclip/assets /tmp/src/paperclip-pixels-plugin/assets

RUN /tmp/build-plugin-bundle.sh /opt/paperclip-pixel-plugin \
    && rm -rf /tmp/src /tmp/build-plugin-bundle.sh

COPY deploy/docker/bridge-stack-entrypoint.sh /usr/local/bin/bridge-stack-entrypoint.sh
COPY deploy/scripts/init-company.sh /usr/local/bin/init-company.sh
RUN chmod +x /usr/local/bin/bridge-stack-entrypoint.sh /usr/local/bin/init-company.sh

# Resolve volume ownership for the non-root UID the upstream entrypoint drops
# to. /paperclip arrives root-owned from a fresh PVC.
RUN mkdir -p /paperclip && chown -R node:node /paperclip /opt/paperclip-pixel-plugin

USER node

ENTRYPOINT ["/usr/local/bin/bridge-stack-entrypoint.sh"]
CMD ["node", "--import", "./server/node_modules/tsx/dist/loader.mjs", "server/dist/index.js"]

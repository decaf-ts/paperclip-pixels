# Development secret values for the Paperclip Pixel Agents bridge stack
# (deploy/k8s, kustomize). Copy to `deploy/k8s/secrets.env` and fill in real
# values BEFORE running `kubectl apply -k deploy/k8s/`. The file is git-ignored;
# never commit real secret material.
#
# These keys feed the kustomize `secretGenerator` entries below.

# Required by the Paperclip host (Better Auth). Use a long random value.
BETTER_AUTH_SECRET=change-me-generate-openssl-rand-hex-32

# Shared secret for the plugin feed endpoint. Configure the same value as the
# Paperclip plugin's pixelAgentsTokenRef secret.
PAPERCLIP_PIXEL_FEED_TOKEN=change-me-generate-openssl-rand-hex-32

# Optional board API key for the click-menu reply forwarder.
PAPERCLIP_PIXEL_API_TOKEN=

# Postgres credentials.
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=change-me-generate-openssl-rand-hex-24
POSTGRES_DB=paperclip
# Full DATABASE_URL consumed by the paperclip host. The host is `postgres`
# (the in-cluster Service name) for the dev manifests.
DATABASE_URL=postgres://paperclip:change-me-generate-openssl-rand-hex-24@postgres:5432/paperclip

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "../dist/e2e",
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["./**/*.ts"],
  "exclude": [
    "../../node_modules", "../dist"]
}
